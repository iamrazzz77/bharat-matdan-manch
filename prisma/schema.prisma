// Prisma Schema for Bharat Matdan Manch - India Digital Election Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model State {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  nameHi    String
  districts District[]
  users     User[]
}

model District {
  id             String         @id @default(uuid())
  stateId        String
  state          State          @relation(fields: [stateId], references: [id])
  name           String
  nameHi         String
  constituencies Constituency[]
}

model Constituency {
  id             String          @id @default(uuid())
  districtId     String
  district       District        @relation(fields: [districtId], references: [id])
  code           String          @unique
  name           String
  nameHi         String
  type           String          @default("PARLIAMENTARY")
  totalVoters    Int             @default(0)
  pollingStations PollingStation[]
  candidates     Candidate[]
  users          User[]
  anonymousVotes AnonymousVote[]
}

model PollingStation {
  id             String         @id @default(uuid())
  constituencyId String
  constituency   Constituency   @relation(fields: [constituencyId], references: [id])
  stationCode    String
  name           String
  nameHi         String
  address        String
  booths         PollingBooth[]
  users          User[]
}

model PollingBooth {
  id             String         @id @default(uuid())
  stationId      String
  pollingStation PollingStation @relation(fields: [stationId], references: [id])
  boothNumber    Int
  officerUserId  String?
}

model User {
  id             String    @id @default(uuid())
  epicNumber     String    @unique
  aadhaarHash    String?   @unique
  fullName       String
  phone          String
  email          String    @unique
  passwordHash   String
  role           String    @default("VOTER")
  stateId        String?
  state          State?    @relation(fields: [stateId], references: [id])
  constituencyId String?
  constituency   Constituency? @relation(fields: [constituencyId], references: [id])
  stationId      String?
  pollingStation PollingStation? @relation(fields: [stationId], references: [id])
  boothNumber    Int?
  isMfaEnabled   Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  participations   VoterParticipation[]
  absenteeRequests AbsenteeRequest[]
  auditLogs        AuditLog[]
}

model Election {
  id          String         @id @default(uuid())
  title       String
  titleHi     String
  type        String         @default("GENERAL")
  status      String         @default("DRAFT")
  startDate   DateTime
  endDate     DateTime
  totalSeats  Int            @default(543)
  description String?

  candidates      Candidate[]
  participations  VoterParticipation[]
  anonymousVotes  AnonymousVote[]
  absenteeRequests AbsenteeRequest[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Party {
  id         String      @id @default(uuid())
  name       String
  nameHi     String
  shortCode  String      @unique
  colorCode  String      @default("#000080")
  symbolIcon String      @default("Flag")
  candidates Candidate[]
}

model Candidate {
  id             String       @id @default(uuid())
  electionId     String
  election       Election     @relation(fields: [electionId], references: [id])
  constituencyId String
  constituency   Constituency @relation(fields: [constituencyId], references: [id])
  partyId        String?
  party          Party?       @relation(fields: [partyId], references: [id])
  fullName       String
  fullNameHi     String
  isNota         Boolean      @default(false)
  affidavitUrl   String?
  ballotOrder    Int          @default(1)

  anonymousVotes AnonymousVote[]
}

model VoterParticipation {
  id            String   @id @default(uuid())
  voterId       String
  voter         User     @relation(fields: [voterId], references: [id])
  electionId    String
  election      Election @relation(fields: [electionId], references: [id])
  votedAt       DateTime @default(now())
  pollingType   String   @default("ONLINE")
  receiptHash   String   @unique
  ipOrBoothHash String

  @@unique([voterId, electionId])
}

model AnonymousVote {
  id              String       @id @default(uuid())
  electionId      String
  election        Election     @relation(fields: [electionId], references: [id])
  constituencyId  String
  constituency    Constituency @relation(fields: [constituencyId], references: [id])
  candidateId     String?
  candidate       Candidate?   @relation(fields: [candidateId], references: [id])
  castAt          DateTime     @default(now())
  hashReceipt     String       @unique
  tamperCheckHash String
}

model AbsenteeRequest {
  id           String    @id @default(uuid())
  voterId      String
  voter        User      @relation(fields: [voterId], references: [id])
  electionId   String
  election     Election  @relation(fields: [electionId], references: [id])
  reason       String
  status       String    @default("PENDING")
  trackingCode String    @unique
  createdAt    DateTime  @default(now())
  approvedAt   DateTime?
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  entityType   String
  entityId     String?
  detailsHash  String
  previousHash String
  createdAt    DateTime @default(now())
}
